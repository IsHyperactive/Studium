{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Studium",
  "version": "0.1.0",
  "identifier": "com.ishyperactive.studium",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Studium",
        "width": 1000,
        "height": 720,
        "minWidth": 320,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Education",
    "shortDescription": "Un espacio para estudiar y aprender",
    "longDescription": "Studium es una aplicación de aprendizaje en desarrollo."
  }
}